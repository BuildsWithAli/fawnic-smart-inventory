# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave everything here unset to use local SQLite)
# A single connection URL (Render's managed-Postgres format) — wins over the discrete vars below:
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# Or the discrete form:
# DATABASE_URL_ENGINE=postgresql
# DATABASE_NAME=fawnic
# DATABASE_USER=fawnic
# DATABASE_PASSWORD=
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI provider selection: claude | openai | gemini | ollama
# This is the first rung of the stock-check fallback chain; any other keys set
# below become additional rungs, with local Ollama always last.
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Optional per-provider model overrides (defaults shown).
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-3.6-flash
# Second Gemini model tried if GEMINI_MODEL is rate-limited, before other providers:
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
