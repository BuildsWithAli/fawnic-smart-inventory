# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave DATABASE_URL_ENGINE unset to use local SQLite)
# DATABASE_URL_ENGINE=postgresql
# DATABASE_NAME=fawnic
# DATABASE_USER=fawnic
# DATABASE_PASSWORD=
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI provider selection: claude | openai | ollama
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
